# MarkMyAss (GhostMark engine) -- example environment configuration.
#
# Copy to `.env` and adjust as needed. EVERY value here is optional: the app
# has safe defaults for local use (`ghostmark ui`) and only the production
# web deployment overrides a handful of them (see docker-compose.prod.yml).
# There are NO secrets in this project -- no API keys, no credentials, no
# database passwords. Nothing here should ever hold a real secret value.
#
# Docker Compose reads a `.env` file automatically; for a bare
# `ghostmark ui`, export these in your shell instead.

# --- Deployment mode -------------------------------------------------------

# "local"  -> localhost-only defaults, high rate limit (single-user).
# "hosted" -> public-internet hardening defaults (lower limits, rate limiting).
# Invalid values fall back to "local".
GHOSTMARK_MODE=local

# Base URL path the app is served under, for reverse-proxy subpath setups.
# "/" for an apex domain; "/ghostmark/" if proxied under a subpath.
GHOSTMARK_BASE_PATH=/

# Absolute public URL, used for canonical links, sitemap, robots, llms.txt.
GHOSTMARK_PUBLIC_URL=https://example.com

# --- Limits & safety -------------------------------------------------------

# Max upload size in MB for binary files (images/PDF). Text files have a
# separate, lower hard-coded ceiling (2 MB) regardless of this value.
# Local default: 50. Hosted deployment uses 10.
GHOSTMARK_MAX_UPLOAD_MB=50

# Per-IP request budget per minute (only meaningful for a public deployment).
# Local default is intentionally high (1000) so routine batch use is unaffected;
# the hosted deployment uses 20.
GHOSTMARK_RATE_LIMIT_PER_MINUTE=20

# Maximum number of jobs processed concurrently before new requests get a 503.
GHOSTMARK_MAX_CONCURRENT=4

# Per-job processing timeout in seconds. A job exceeding this returns 503.
GHOSTMARK_PROCESSING_TIMEOUT_SECONDS=30

# Session (and its temp files) time-to-live in minutes. Clamped to [1, 15].
# Uploaded files are deleted when the session expires, on explicit delete,
# and on process exit.
GHOSTMARK_SESSION_TTL_MINUTES=12

# --- Persistence -----------------------------------------------------------

# Path to the durable, aggregate-only usage-stats SQLite DB (homepage
# social-proof counters ONLY -- never any uploaded file, IP, or filename).
# Unset -> an ephemeral temp-dir file (fine for local/dev). The production
# deployment points this at a dedicated writable volume so the counter
# survives restarts (see docker-compose.prod.yml).
GHOSTMARK_STATS_DB=/data/stats.db
